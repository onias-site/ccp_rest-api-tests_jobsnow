package com.jn.entities.decorators.entidades;

import org.junit.Test;

import com.ccp.decorators.CcpJsonRepresentation;
import com.ccp.especifications.db.utils.entity.CcpEntity;
import com.jn.entities.JnEntityLoginPassword;
import com.jn.entities.decorators.TemplateDeTestesDeDecoratorDeEntidade;
import com.jn.json.fields.validation.JnJsonCommonsFields;

/**
 * jn_login_password: gêmea de jn_login_password_locked (senha bloqueada), {@code @CcpEntityCache(3600)},
 * versionável, transformador (hash do e-mail e BCrypt da senha) e validador (força da senha).
 */
public class JnEntityLoginPasswordDecoratorsTest extends TemplateDeTestesDeDecoratorDeEntidade {

	private static final String SENHA = "Senha#12345";

	protected CcpEntity entidade() {
		return JnEntityLoginPassword.ENTITY;
	}

	protected CcpJsonRepresentation registroValido() {
		return this.com(JnJsonCommonsFields.email, this.email)
				.put(JnJsonCommonsFields.password, SENHA);
	}

	@Test
	public void cadeia() {
		this.deveTerACadeia("DecoratorFieldsValidatorEntity", "DecoratorFieldsTransformerEntity", "JnVersionablePurgeEntity", "DecoratorTwinEntity", "DecoratorCacheEntity", "JnVersionableEntity", "DefaultImplementationEntity");
	}

	@Test
	public void gravarLerEApagar() {
		this.deveGravarLerEApagar();
	}

	@Test
	public void validador() {
		this.deveRecusarRegistroInvalido(this.registroValido().put(JnJsonCommonsFields.password, "fraca"));
	}

	@Test
	public void transformadorDoEmail() {
		this.deveGuardarEmailComoHash();
	}

	@Test
	public void transformadorDaSenha() {
		this.deveGuardarTransformado(JnJsonCommonsFields.password, SENHA);
	}

	@Test
	public void cache() {
		this.deveServirLeituraDoCacheEInvalidarNaEscrita();
	}

	@Test
	public void gemea() {
		this.deveAlternarEntrePrincipalEGemea("jn_login_password_locked");
	}

	@Test
	public void redirectParaAGemea() {
		this.deveAvisarNoGetOneByIdQueORegistroFoiParaAGemea();
	}

	@Test
	public void versionavel() {
		this.deveRegistrarHistoricoACadaEscrita();
	}

	@Test
	public void expurgoDoHistorico() {
		this.deveExpurgarOHistoricoNoDeleteAnyWhere();
	}
}
