package com.jn.entities.decorators.entidades;

import org.junit.Test;

import com.ccp.decorators.CcpJsonRepresentation;
import com.ccp.especifications.db.utils.entity.CcpEntity;
import com.jn.entities.JnEntityEmailTemplateMessage;
import com.jn.entities.decorators.TemplateDeTestesDeDecoratorDeEntidade;
import com.jn.json.fields.validation.JnJsonCommonsFields;

/**
 * jn_email_template_message: {@code @CcpEntityCache(3600)}, versionável, transformador e validador.
 * O {@code templateId} é o nome desta classe de teste, para não tocar nos templates reais.
 */
public class JnEntityEmailTemplateMessageDecoratorsTest extends TemplateDeTestesDeDecoratorDeEntidade {

	protected CcpEntity entidade() {
		return JnEntityEmailTemplateMessage.ENTITY;
	}

	protected CcpJsonRepresentation registroValido() {
		return this.com(JnJsonCommonsFields.templateId, this.getClass().getName())
				.put(JnJsonCommonsFields.language, "portuguese")
				.put(JnJsonCommonsFields.subject, "assunto de teste")
				.put(JnJsonCommonsFields.message, "corpo do email de teste " + this.unico);
	}

	@Test
	public void cadeia() {
		this.deveTerACadeia("DecoratorFieldsValidatorEntity", "DecoratorFieldsTransformerEntity", "JnVersionablePurgeEntity", "DecoratorCacheEntity", "JnVersionableEntity", "DefaultImplementationEntity");
	}

	@Test
	public void gravarLerEApagar() {
		this.deveGravarLerEApagar();
	}

	@Test
	public void validador() {
		this.deveRecusarRegistroInvalido(this.registroValido().removeFields(JnJsonCommonsFields.subject));
	}

	@Test
	public void cache() {
		this.deveServirLeituraDoCacheEInvalidarNaEscrita();
	}

	@Test
	public void versionavel() {
		this.deveRegistrarHistoricoACadaEscrita();
	}
}
